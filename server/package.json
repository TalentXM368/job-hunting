{
  "name": "jobhunt-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:all": "concurrently -k -n api,ui -c blue,green \"npm run dev\" \"npm --prefix ../frontend run dev\"",
    "dev": "tsx watch src/dev.ts",
    "start": "tsx src/dev.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.6",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.9.0",
    "hono": "^4.13.17",
    "kysely": "^0.29.8",
    "nodemailer": "^10.4.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^10.0.7",
    "prisma": "^7.10.1",
    "prisma-kysely": "^3.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
