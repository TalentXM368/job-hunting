# --- LLM: resume extraction, screening and kit drafting --------------------
# Providers: anthropic | gemini | groq | openai-compatible | ollama
# SCREEN_PROVIDER / DRAFT_PROVIDER override LLM_PROVIDER for one stage.
LLM_PROVIDER=gemini
GEMINI_API_KEY=paste-your-gemini-api-key-here
SCREEN_MODEL=gemini-3.5-flash-lite
DRAFT_MODEL=gemini-3.6-flash
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# How much the LLM is used for matching. Every job always gets a free
# rule-based score first.
#   hybrid  (default) the LLM re-scores only the best few rule-scored jobs
#   rules   never calls the LLM for matching
#   llm     the LLM scores every screened job (the most tokens)
# SCORING_MODE=hybrid
# In hybrid mode: at most this many jobs per run go to the LLM, and only
# those whose rule score reaches the floor.
# LLM_RESCORE_MAX=10
# LLM_RESCORE_MIN=5

# --- Database ---------------------------------------------------------------
# Neon Postgres. The app uses the pooled URL; migrations need the direct one.
# Both are on the Neon dashboard under "Connection details" (toggle "Pooled").
# Leave DATABASE_URL unset on your own machine to use an embedded database
# stored in server/.data instead.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Resume files -----------------------------------------------------------
# Required on Vercel (functions have no disk): create a Blob store in the
# Vercel project and it sets this. Unset locally, files go to server/.data.
# BLOB_READ_WRITE_TOKEN=

# --- Daily run --------------------------------------------------------------
# Vercel Cron sends this as a bearer token to /api/cron/daily. Set it in the
# Vercel project so nobody else can trigger a run.
# CRON_SECRET=

# --- Email digest -----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_TO=your-email@gmail.com
